{
  "name": "church-platform/app",
  "description": "Multi-tenant church invitation platform",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-gd": "*",
    "ext-openssl": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "migrate": "php bin/migrate.php",
    "test": "php tests/run.php",
    "serve": "php -S 127.0.0.1:8080 -t public"
  }
}
