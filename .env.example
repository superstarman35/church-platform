APP_NAME="Church Invitation Platform"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=Asia/Seoul
APP_KEY=base64:replace-with-output-from-php-bin-generate-key

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=church_platform
DB_USERNAME=church_app
DB_PASSWORD=change-this-locally
DB_CHARSET=utf8mb4

SESSION_NAME=church_platform_session
SESSION_SECURE=false
SESSION_SAMESITE=Lax
SESSION_LIFETIME=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Must point to storage outside this application/server disk in production.
BACKUP_EXTERNAL_DIR=/mnt/external-backups/church-platform
BACKUP_PASSPHRASE=replace-with-a-long-random-secret
# Dedicated empty database used only for restore drills. Never set this to DB_DATABASE.
RESTORE_TEST_DB=church_platform_restore_test
